    "goals.info.allocations": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money already set aside for this goal from your accounts. It counts toward the goal's progress and is excluded from Safe to spend — so you won't spend it by accident."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги, уже отложенные на эту цель с твоих счетов. Они входят в прогресс цели и не учитываются в «Можно потратить» — так ты не потратишь их случайно."
          }
        }
      }
    },
    "goals.info.contribution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much goes toward this goal every month: recurring transfers tied to it plus its share of your monthly savings. The bigger the contribution, the sooner the forecast reaches the target."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько уходит на эту цель каждый месяц: регулярные переводы, привязанные к ней, плюс её доля твоих ежемесячных накоплений. Чем больше взнос, тем раньше прогноз дойдёт до цели."
          }
        }
      }
    },
    "goals.info.forecast": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The forecast is built month by month from your current savings, your monthly contributions at the planning rate, and the one-time money you expect. Where the line crosses the target amount is your estimated completion date. Change a contribution or the rate — and the date moves too."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогноз строится из твоих текущих накоплений, ежемесячных взносов по плановому курсу и ожидаемых поступлений — месяц за месяцем до цели. Где линия пересекает сумму цели — там примерная дата её достижения. Изменишь взнос или курс — сдвинется и дата."
          }
        }
      }
    },
    "goals.info.milestones": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkpoints on the way to the target — a quarter, half, three quarters and the full amount. Each shows when the forecast expects you to get there, so the path becomes a series of near steps instead of one distant date."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контрольные отметки на пути к цели — четверть, половина, три четверти и вся сумма. У каждой видно, когда по прогнозу ты до неё доберёшься: путь превращается в близкие шаги, а не одну далёкую дату."
          }
        }
      }
    },
    "goals.milestones.beyondHorizon": {
      "extractionState": "manual",
