    "plan.info.whatif.free": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income minus scenario savings minus regular mandatory expenses (rent, subscriptions). Negative means the scenario spends more than you earn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доход минус накопления сценария минус регулярные обязательные расходы (аренда, подписки). Минус означает: в этом сценарии ты тратишь больше, чем зарабатываешь."
          }
        }
      }
    },
    "plan.info.whatif.income": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each income source has a share that goes to savings. Move the shares and watch how the completion date shifts when your plan gets more — or less — of each income. Try it here before changing anything for real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого источника дохода есть доля, которая идёт в накопления. Подвигай доли и посмотри, как сдвигается дата достижения цели, если отдавать плану больше или меньше с каждого дохода. Сначала попробуй здесь — потом меняй в реальности."
          }
        }
      }
    },
