    "dashboard.info.chart": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The solid line is what actually happened to your savings. The dashed line is the forecast from today on — planned contributions and expected money. The horizontal line is the target: where the forecast crosses it is roughly when you get there."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сплошная линия — что реально происходило с накоплениями. Пунктир — прогноз с сегодняшнего дня: плановые взносы и ожидаемые поступления. Горизонтальная линия — сумма цели: где прогноз её пересекает, туда ты примерно и придёшь."
          }
        }
      }
    },
    "dashboard.info.month": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Income and spending recorded in this calendar month, and the difference between them. It answers one question: this month, are you ahead or behind?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доходы и траты этого календарного месяца и разница между ними. Отвечает на один вопрос: в этом месяце ты в плюсе или в минусе?"
          }
        }
      }
    },
    "dashboard.info.sts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Money on accounts minus what is reserved for goals, minus payments due before your next income, minus your safety buffer. Tap \"Why this amount?\" to see every component — including which goals hold the reserves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Деньги на счетах минус зарезервированное на цели, минус платежи до следующего дохода, минус твой страховой буфер. Нажми «Почему столько?» — увидишь каждую составляющую, включая какие именно цели держат резерв."
          }
        }
      }
    },
