    "onboarding.info.rate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The planning rate converts your savings into the goal's currency. It doesn't need to be exact — a rough market rate is enough. The preview below shows what your amount turns into, so a flipped direction is easy to spot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плановый курс переводит твои накопления в валюту цели. Точность до копейки не нужна — достаточно примерного рыночного курса. Предпросмотр ниже показывает, во что превращается твоя сумма, — перепутанное направление сразу видно."
          }
        }
      }
    },
